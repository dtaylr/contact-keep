{
  "name": "contact-keeper",
  "version": "1.0.0",
  "description": "Contact manager app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix client",
    "clientinstall": "npm install --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "cypress": "npm run cypress:api",
    "cypress:api": "jest --runInBand",
    "cypress:e2e": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "cypress:e2e:critical": "env -u ELECTRON_RUN_AS_NODE cypress run --expose grepTags=@critical,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:smoke": "env -u ELECTRON_RUN_AS_NODE cypress run --expose grepTags=@smoke,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:auth": "env -u ELECTRON_RUN_AS_NODE cypress run --expose grepTags=@auth,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:contacts": "env -u ELECTRON_RUN_AS_NODE cypress run --expose grepTags=@contacts,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:import": "env -u ELECTRON_RUN_AS_NODE cypress run --expose grepTags=@import,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:analytics": "env -u ELECTRON_RUN_AS_NODE cypress run --expose grepTags=@analytics,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:desktop": "env -u ELECTRON_RUN_AS_NODE cypress run --expose grepTags=@desktop,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:mobile": "env -u ELECTRON_RUN_AS_NODE cypress run --expose grepTags=@mobile,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:chrome": "env -u ELECTRON_RUN_AS_NODE cypress run --browser chrome",
    "cypress:e2e:firefox": "env -u ELECTRON_RUN_AS_NODE cypress run --browser firefox",
    "cypress:e2e:edge": "env -u ELECTRON_RUN_AS_NODE cypress run --browser edge",
    "cypress:e2e:webkit": "env -u ELECTRON_RUN_AS_NODE cypress run --browser webkit",
    "cypress:e2e:chrome:critical": "env -u ELECTRON_RUN_AS_NODE cypress run --browser chrome --expose grepTags=@critical,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:chrome:smoke": "env -u ELECTRON_RUN_AS_NODE cypress run --browser chrome --expose grepTags=@smoke,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:firefox:critical": "env -u ELECTRON_RUN_AS_NODE cypress run --browser firefox --expose grepTags=@critical,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:edge:critical": "env -u ELECTRON_RUN_AS_NODE cypress run --browser edge --expose grepTags=@critical,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:webkit:critical": "env -u ELECTRON_RUN_AS_NODE cypress run --browser webkit --expose grepTags=@critical,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:webkit:smoke": "env -u ELECTRON_RUN_AS_NODE cypress run --browser webkit --expose grepTags=@smoke,grepFilterSpecs=true,grepOmitFiltered=true",
    "cypress:e2e:ci": "start-server-and-test client http://localhost:3000 cypress:e2e",
    "cypress:e2e:ci:critical": "start-server-and-test client http://localhost:3000 cypress:e2e:critical",
    "cypress:e2e:ci:smoke": "start-server-and-test client http://localhost:3000 cypress:e2e:smoke",
    "cypress:e2e:ci:auth": "start-server-and-test client http://localhost:3000 cypress:e2e:auth",
    "cypress:e2e:ci:contacts": "start-server-and-test client http://localhost:3000 cypress:e2e:contacts",
    "cypress:e2e:ci:import": "start-server-and-test client http://localhost:3000 cypress:e2e:import",
    "cypress:e2e:ci:analytics": "start-server-and-test client http://localhost:3000 cypress:e2e:analytics",
    "cypress:e2e:ci:desktop": "start-server-and-test client http://localhost:3000 cypress:e2e:desktop",
    "cypress:e2e:ci:mobile": "start-server-and-test client http://localhost:3000 cypress:e2e:mobile",
    "cypress:e2e:ci:chrome": "start-server-and-test client http://localhost:3000 cypress:e2e:chrome",
    "cypress:e2e:ci:firefox": "start-server-and-test client http://localhost:3000 cypress:e2e:firefox",
    "cypress:e2e:ci:edge": "start-server-and-test client http://localhost:3000 cypress:e2e:edge",
    "cypress:e2e:ci:webkit": "start-server-and-test client http://localhost:3000 cypress:e2e:webkit",
    "cypress:e2e:ci:chrome:critical": "start-server-and-test client http://localhost:3000 cypress:e2e:chrome:critical",
    "cypress:e2e:ci:chrome:smoke": "start-server-and-test client http://localhost:3000 cypress:e2e:chrome:smoke",
    "cypress:e2e:ci:firefox:critical": "start-server-and-test client http://localhost:3000 cypress:e2e:firefox:critical",
    "cypress:e2e:ci:edge:critical": "start-server-and-test client http://localhost:3000 cypress:e2e:edge:critical",
    "cypress:e2e:ci:webkit:critical": "start-server-and-test client http://localhost:3000 cypress:e2e:webkit:critical",
    "cypress:e2e:ci:webkit:smoke": "start-server-and-test client http://localhost:3000 cypress:e2e:webkit:smoke",
    "cypress:e2e:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "structure:check": "node scripts/validate-repo-structure.js",
    "release:gate": "node scripts/validate-release-gate.js",
    "local:check": "npm run structure:check && npm run release:gate && npm run cypress && npm audit --omit=dev && npm audit --prefix client --omit=dev && npm run build --prefix client",
    "cypress:install": "env -u ELECTRON_RUN_AS_NODE cypress install",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false npm install --prefix client && npm run build --prefix client"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.17.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0"
  },
  "devDependencies": {
    "@cypress/grep": "^6.0.2",
    "concurrently": "^9.2.4",
    "cypress": "^15.19.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "playwright-webkit": "^1.61.1",
    "start-server-and-test": "^3.0.11",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
