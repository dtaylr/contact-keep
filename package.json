{
  "name": "contact-keeper",
  "version": "1.0.0",
  "description": "Contact manager app",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "server": "nodemon server.js",
    "client": "npm start --prefix client",
    "clientinstall": "npm install --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "test": "npm run test:api",
    "test:api": "jest --runInBand",
    "test:e2e": "env -u ELECTRON_RUN_AS_NODE cypress run",
    "test:e2e:ci": "start-server-and-test client http://localhost:3000 test:e2e",
    "test:e2e:open": "env -u ELECTRON_RUN_AS_NODE cypress open",
    "release:gate": "node scripts/validate-release-gate.js",
    "local:check": "npm run release:gate && npm test && npm audit --omit=dev && npm audit --prefix client --omit=dev && npm run build --prefix client",
    "cypress:install": "env -u ELECTRON_RUN_AS_NODE cypress install",
    "heroku-postbuild": "NPM_CONFIG_PRODUCTION=false npm install --prefix client && npm run build --prefix client"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "express": "^4.17.1",
    "express-rate-limit": "^7.4.1",
    "express-validator": "^7.3.2",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.8.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "cypress": "^15.19.0",
    "jest": "^30.4.2",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.14",
    "start-server-and-test": "^3.0.11",
    "supertest": "^7.2.2"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
